generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "sqlserver"
  url               = env("DATABASE_URL")

}

// role: SALES | OPERATIONS
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  password_hash String
  role          String         @default("SALES")
  created_at    DateTime       @default(now())
  holds         Hold[]
  audit_logs    AuditLog[]
  otp_codes     OtpCode[]

  @@map("app_users")
}

// status: HOLD | COMMITTED | ATT_SOFT | EXPIRED
// source: INTERNAL | SALESFORCE | CLIENT
// origination: frontend | mcp
model Hold {
  id                  String     @id @default(cuid())
  truck_number        String
  market              String
  state               String
  client_name         String
  start_date          DateTime
  end_date            DateTime
  status              String     @default("HOLD")
  source              String     @default("INTERNAL")
  origination         String     @default("frontend")
  notes               String?
  created_by          String
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt
  // Set only for holds pushed in from Salesforce — lets repeat pushes for the
  // same Opportunity update the existing hold instead of creating duplicates.
  sfdc_opportunity_id String?
  sfdc_hold_exp       DateTime?
  user                User       @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  audit_logs          AuditLog[]

  @@map("app_holds")
}

// status: PENDING | APPROVED | REJECTED | EXPIRED | EXTENSION_REQUESTED
// source: INTERNAL | SALESFORCE | CLIENT
// pricing_tier: Good | Better | Best
model HoldRequest {
  id                  String     @id @default(cuid())
  client_user_id      String
  truck_number        String
  market              String
  state               String?
  start_date          DateTime
  end_date            DateTime
  notes               String?    @db.NVarChar(Max)
  status              String     @default("PENDING")
  source              String     @default("CLIENT")
  // Pricing snapshot — locked at hold creation from the quote engine
  pricing_tier        String?                        // Good | Better | Best
  quoted_total        Float?                         // total price at the selected tier (campaign-level)
  daily_rate          Float?                         // per-truck per-day rate
  features            String?    @db.NVarChar(Max)   // JSON: { smartDirectional, deviceId, studies, shadowFencing }
  truck_count         Int?                           // total trucks in the campaign group
  campaign_group_id   String?                        // groups multi-truck holds into one campaign
  sfdc_opportunity_id String?                        // Salesforce Opportunity ID (outbound-created)
  // Expiration — 72h default from creation, capped by campaign start date.
  expires_at          DateTime?
  extension_reason    String?    @db.NVarChar(Max)   // client's reason when requesting extension
  extension_until     DateTime?                       // requested extension date (client picks)
  created_at          DateTime   @default(now())
  client_user         ClientUser @relation(fields: [client_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([campaign_group_id])
  @@map("app_hold_requests")
}

model ClientUser {
  id            String             @id @default(cuid())
  username      String             @unique
  password_hash String
  company_name  String
  // Optional link to a RateAgreement.partner_id — lets the client-portal AI quote engine apply
  // this client's negotiated rate instead of the standard rate card. Null means standard pricing.
  // Set by ops via the admin client-users screen; not self-serve.
  partner_id      String?
  // Salesforce Account ID — links this client to their SFDC Account so outbound
  // opportunities can be created under the correct account.
  sfdc_account_id  String?
  created_at    DateTime           @default(now())
  hold_requests HoldRequest[]
  ai_questions  ClientAiQuestion[]

  @@map("app_client_users")
}

// Every question a client has asked the client-portal AI assistant, across all
// clients in one table — a dedicated log for reporting, decoupled from the
// conversation-threading internals of dbo.client_chat_conversations /
// dbo.client_chat_messages (which already store this too, but joined through
// conversations rather than as a flat per-question log).
model ClientAiQuestion {
  id             String     @id @default(cuid())
  client_user_id String
  // Denormalized at write time so this table alone (no join) shows who asked — a log/audit
  // table like this should reflect the name AT THE TIME the question was asked anyway.
  company_name   String     @default("")
  question       String     @db.NVarChar(Max)
  // The assistant's reply text (plus the action-result message, if any) for this question.
  // Written together with the row once the reply is ready, not at question time — so a row
  // always has both sides, or neither if the assistant call itself failed.
  answer         String     @default("") @db.NVarChar(Max)
  asked_at       DateTime   @default(now())
  client_user    ClientUser @relation(fields: [client_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([client_user_id])
  @@map("app_client_ai_questions")
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  truck_number String
  user_id      String
  hold_id      String?
  details      String?
  created_at   DateTime @default(now())
  user         User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hold         Hold?    @relation(fields: [hold_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("app_audit_logs")
}

// Login OTP — one active (non-consumed) row per user at a time. A fresh
// request-otp call deletes any prior unconsumed row for that user before
// inserting a new one, so there's never more than one code valid at once.
model OtpCode {
  id          String    @id @default(cuid())
  user_id     String
  code_hash   String
  expires_at  DateTime
  attempts    Int       @default(0)
  consumed_at DateTime?
  created_at  DateTime  @default(now())
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
  @@map("app_login_otps")
}

// user_type: app_user | client_user
// No hard FK on user_id — target table depends on user_type
model McpToken {
  id          String    @id @default(cuid())
  token_hash  String
  user_id     String    @db.NVarChar(255)
  user_type   String    @default("app_user")
  label       String
  created_at  DateTime  @default(now())
  revoked_at  DateTime?

  @@map("mcp_tokens")
}

// outcome: success | no_availability | error
// user_type: app_user | client_user
// No hard FK on user_id or token_id — user_id target depends on user_type
model McpQueryLog {
  id               String   @id @default(cuid())
  user_id          String?  @db.NVarChar(255)
  user_type        String?
  token_id         String?
  tool_name        String
  request_params   String?  @db.NVarChar(Max)
  response_summary String?  @db.NVarChar(Max)
  outcome          String
  latency_ms       Int
  created_at       DateTime @default(now())

  @@index([user_id, created_at])
  @@index([tool_name, outcome])
  @@map("mcp_query_log")
}

// --- Self-Service Quoting ---

// agreement_type: standard | volume_discount | flat_rate | custom
model RateAgreement {
  id              String   @id @default(cuid())
  partner_id      String
  name            String
  agreement_type  String   @default("standard")
  effective_date  DateTime
  expiration_date DateTime
  rate_overrides  String   // JSON: selective overrides to the standard rate card
  created_by      String
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("app_rate_agreements")
}

// Operational bases where Lime maintains driver pools and fleet presence.
// Any campaign city within 450 miles of an accepted market is serviceable.
// Beyond 450 miles = outside service area.
model AcceptedMarket {
  id               String   @id @default(cuid())
  dma_code         String   @unique
  dma_name         String
  lat              Float
  lng              Float
  base_concurrency Int      @default(1)  // max simultaneous trucks before swarm trigger
  notes            String?
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("app_accepted_markets")
}
